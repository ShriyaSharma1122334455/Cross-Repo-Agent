# GitHub App auth (required)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# Org this agent watches consumer repos in (required)
TARGET_ORG=

# Bedrock model tiers
BEDROCK_MODEL_CHEAP=anthropic.claude-haiku
BEDROCK_MODEL_STRONG=anthropic.claude-sonnet
AWS_REGION=us-east-1

# Thresholds
MECHANICAL_FIX_CONFIDENCE_THRESHOLD=0.8

# State backend: sqlite (local) or dynamo (deployed)
STATE_BACKEND=sqlite
SQLITE_PATH=.local/state.db
DYNAMO_TABLE=blast-radius-actions
